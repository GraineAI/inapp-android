<?xml version="1.0" encoding="utf-8"?>
<!-- The test APK only: an activity in front for the live call, as an app's own screen is when it calls the agent; the call screen's gallery. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plain HTTP for the live test's local relay only (the weak-network lab's 10.0.2.2:18787, which refuses the
         WebRTC mint so a ring is carried on the WebSocket); this is the test APK, never an app's. -->
    <application android:usesCleartextTraffic="true">
        <activity android:name="ai.graine.inapp.RtcLiveActivity" android:exported="false" />
        <!-- The call screen in any design and moment, for screenshots (CallScreenGalleryActivity.kt). -->
        <activity
            android:name="ai.graine.inapp.CallScreenGalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
